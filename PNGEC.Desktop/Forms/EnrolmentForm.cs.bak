        #region Populate Pager
        /// <summary>
        /// Populates the pager.
        /// </summary>
        /// <param name="recordCount">The record count.</param>
        /// <param name="currentPage">The current page.</param>
        private void PopulatePager(int recordCount, int currentPage, int pageSize)
        {
            List<Page> pages = new List<Page>();
            int startIndex, endIndex;
            int pagerSpan = 5;

            //Calculate the Start and End Index of pages to be displayed.
            double dblPageCount = (double)(recordCount / Convert.ToDecimal(pageList.PageSize));
            int pageCount = (int)Math.Ceiling(dblPageCount);
            startIndex = currentPage > 1 && currentPage + pagerSpan - 1 < pagerSpan ? currentPage : 1;
            endIndex = pageCount > pagerSpan ? pagerSpan : pageCount;
            if (currentPage > pagerSpan % 2)
            {
                if (currentPage == 2)
                {
                    endIndex = 5;
                }
                else
                {
                    endIndex = currentPage + 2;
                }
            }
            else
            {
                endIndex = (pagerSpan - currentPage) + 1;
            }

            if (endIndex - (pagerSpan - 1) > startIndex)
            {
                startIndex = endIndex - (pagerSpan - 1);
            }

            if (endIndex > pageCount)
            {
                endIndex = pageCount;
                startIndex = ((endIndex - pagerSpan) + 1) > 0 ? (endIndex - pagerSpan) + 1 : 1;
            }

            //Add the First Page Button.
            if (currentPage > 1)
            {
                //var bitmap = new Bitmap(global::PNGEC.Desktop.Properties.Resources.first);
                pages.Add(new Page { Text = "First", Value = "1" });
            }

            //Add the Previous Button.
            if (currentPage > 5)
            {
                pages.Add(new Page { Text = "<<", Value = (currentPage - 5).ToString() });
            }

            if (currentPage > 1)
            {
                pages.Add(new Page { Text = "<", Value = (currentPage - 1).ToString() });
            }

            for (int i = startIndex; i <= endIndex; i++)
            {
                pages.Add(new Page { Text = i.ToString(), Value = i.ToString(), Selected = i == currentPage });
            }

            //Add the Next Button.
            if (currentPage < pageCount)
            {
                pages.Add(new Page { Text = ">", Value = (currentPage + 1).ToString() });
            }

            if (currentPage < pageCount)
            {
                pages.Add(new Page { Text = ">>", Value = (currentPage + 5).ToString() });
            }

            //Add the Last Button.
            if (currentPage != pageCount)
            {
                pages.Add(new Page { Text = "Last", Value = pageCount.ToString() });
            }

            //Clear existing Pager Buttons.
            pnlPaginationLeft.Controls.Clear();

            if (dgEnrolmentForms != null && dgEnrolmentForms.Rows.Count > 0)
            {
                //Loop and add Buttons for Pager.
                int count = 0;
                foreach (Page page in pages)
                {
                    Button btnPage = new Button();
                    btnPage.Location = new System.Drawing.Point(65 * count, 5);
                    btnPage.Size = new System.Drawing.Size(65, 30);
                    btnPage.Font = new System.Drawing.Font("Arial", 10F, System.Drawing.FontStyle.Regular, System.Drawing.GraphicsUnit.Point, 0);
                    btnPage.Name = page.Value;
                    btnPage.Text = page.Text;
                    btnPage.Enabled = !page.Selected;
                    btnPage.Click += new System.EventHandler(this.Page_Click);
                    pnlPaginationLeft.Controls.Add(btnPage);
                    count++;
                }
                this.cmbPageSize.SelectedIndexChanged -= this.CmbPageSize_SelectedIndexChanged;
                cmbPageSize.DataSource = pageSizeArray;
                pnlPaginationRight.Visible = true;
                this.cmbPageSize.SelectedIndexChanged += this.CmbPageSize_SelectedIndexChanged;
            }
        }

        #endregion

        #region Export Registration Card
        /// <summary>
        /// Exports the registration card.
        /// </summary>
        /// <returns></returns>
        private byte[] ExportRegistrationCard()
        {
            byte[] bytes = null;

            if (dsRegistrationCard.Tables[0].Rows != null && dsRegistrationCard.Tables[0].Rows.Count > 0)
            {
                Warning[] warnings;
                string[] streamIds;
                string mimeType = string.Empty;
                string encoding = string.Empty;
                string extension = string.Empty;

                ReportDataSource dataSource = new ReportDataSource("ds_RegistrationCard", dsRegistrationCard.Tables[0]);
                ReportViewer viewer = new ReportViewer();
                viewer.LocalReport.Refresh();

                System.Drawing.Printing.PageSettings pageSettings = new System.Drawing.Printing.PageSettings();
                viewer.LocalReport.ReportPath = "Report/RegistrationCard.rdlc";
                viewer.LocalReport.DataSources.Add(dataSource);
                viewer.LocalReport.SubreportProcessing += new SubreportProcessingEventHandler(SetSubDataSource);
                bytes = viewer.LocalReport.Render("PDF", null, out mimeType, out encoding, out extension, out streamIds, out warnings);
            }

            return bytes;
        }
        #endregion

        #region SetSubDataSource
        /// <summary>
        /// Sets the sub data source.
        /// </summary>
        /// <param name="sender">The sender.</param>
        /// <param name="e">The <see cref="SubreportProcessingEventArgs"/> instance containing the event data.</param>
        private void SetSubDataSource(object sender, SubreportProcessingEventArgs e)
        {
            string RegistrationCardNo = Convert.ToString(e.Parameters[0].Values[0]);

            if (!string.IsNullOrWhiteSpace(RegistrationCardNo))
            {
                DataTable tblSubRCardFiltered = dsRegistrationCard.Tables[1].AsEnumerable().Where(row => row.Field<String>("RegistrationCardNo") == RegistrationCardNo).CopyToDataTable();
                tblSubRCardFiltered.TableName = "tblSubRegistrationCard";
                ReportDataSource datasource = new ReportDataSource("ds_SubRegistrationCard", tblSubRCardFiltered);
                e.DataSources.Add(datasource);
            }
        }
        #endregion

        #endregion

        #region EnrolmentFormsExportReportSource
        /// <summary>
        /// Enrolments the forms export report source.
        /// </summary>
        /// <param name="startRange">The start range.</param>
        /// <param name="endRange">The end range.</param>
        /// <param name="provinceId">The province identifier.</param>
        /// <param name="wardId">The ward identifier.</param>
        /// <param name="regionId">The region identifier.</param>
        /// <param name="districtId">The district identifier.</param>
        /// <param name="llgId">The LLG identifier.</param>
        /// <param name="batchName">Name of the batch.</param>
        /// <returns></returns>
        private async Task<byte[]> EnrolmentFormsExportReportSource(int startRange, int endRange, int regionId, int provinceId, int districtId, int llgId, int wardId, string batchName)
        {
            byte[] bytes = null;

            await Task.Delay(10);

            var numberOfForms = endRange - startRange;
            string[] PDFfilepaths = new string[numberOfForms + 1];
            string FormNo, qrCodeHashNumber, QRCodeUrl, firstFormNo = "", lastFormNo = "";

            dtForm11 = new DataTable("tblForm11");
            dtForm11.Clear();
            dtForm11.Columns.Add("FormId", typeof(Int32));
            dtForm11.Columns.Add("FormNo");

            dtSubForm11 = new DataTable("tblSubForm11");
            dtSubForm11.Clear();
            dtSubForm11.Columns.Add("FormId", typeof(Int32));
            dtSubForm11.Columns.Add("FormNo");
            dtSubForm11.Columns.Add("QRCodeUrl");

            for (int i = 0; i <= numberOfForms; i++)
            {
                DataRow drForm11 = dtForm11.NewRow();
                DataRow drSubForm11 = dtSubForm11.NewRow();

                drForm11["FormId"] = (i + 1);
                drSubForm11["FormId"] = (i + 1);

                FormNo = this.GenerateFormNumber(i, startRange, provinceId, wardId);
                FormNo.Replace("#", "");
                drForm11["FormNo"] = FormNo;
                drSubForm11["FormNo"] = FormNo;

                qrCodeHashNumber = GenerateQRCodeHashNumber(regionId, provinceId, districtId, llgId, wardId, batchName, i, startRange);

                QRCodeUrl = this.GenerateQRCode(qrCodeHashNumber);
                drSubForm11["QRCodeUrl"] = @"file:\" + QRCodeUrl;

                dtForm11.Rows.Add(drForm11);
                dtSubForm11.Rows.Add(drSubForm11);

                if (i == 0)
                {
                    firstFormNo = FormNo;
                }
                else if (i == numberOfForms)
                {
                    lastFormNo = FormNo;
                }
            }

            var RegionName = Globals.GeoList.RegionList.Where(x => x.RegionId == regionId).Select(y => y.RegionName).FirstOrDefault();
            var ProvinceName = Globals.GeoList.ProvinceList.Where(x => x.ProvinceId == provinceId).Select(y => y.ProvinceName).FirstOrDefault();
            var DistrictName = Globals.GeoList.DistrictList.Where(x => x.DistrictId == districtId).Select(y => y.DistrictName).FirstOrDefault();
            var LLGName = Globals.GeoList.LLGList.Where(x => x.LLGId == llgId).Select(y => y.LLGName).FirstOrDefault();
            var WardName = Globals.GeoList.WardList.Where(x => x.WardId == wardId).Select(y => y.WardName).FirstOrDefault();
            var LocationNameList = Globals.GeoList.LocationList.Where(x => x.RegionId == regionId
                && x.ProvinceId == provinceId
                && x.DistrictId == districtId
                && x.LLGId == llgId
                && x.WardId == wardId).Select(y => y.LocationName).ToList();
            string LocationStr = string.Join(",", LocationNameList);

            if ((dtForm11 != null && dtSubForm11 != null) && (dtForm11.Rows.Count > 0 && dtSubForm11.Rows.Count > 0))
            {
                dsForm11 = new DataSet();
                dsForm11.Tables.AddRange(new DataTable[] { dtForm11, dtSubForm11 });

                if (dsForm11.Tables[0].Rows != null && dsForm11.Tables[0].Rows.Count > 0)
                {
                    Warning[] warnings;
                    string[] streamIds;
                    string mimeType = string.Empty;
                    string encoding = string.Empty;
                    string extension = string.Empty;
                    dsForm11.Tables[0].TableName = "tblForm11";

                    ReportParameter[] param = new ReportParameter[8];
                    param[0] = new ReportParameter("Region", RegionName, true);
                    param[1] = new ReportParameter("Province", ProvinceName, true);
                    param[2] = new ReportParameter("District", DistrictName, true);
                    param[3] = new ReportParameter("LLG", LLGName, true);
                    param[4] = new ReportParameter("Ward", WardName, true);
                    param[5] = new ReportParameter("Location", LocationStr, true);
                    param[6] = new ReportParameter("FormCount", Convert.ToString(numberOfForms + 1), true);
                    param[7] = new ReportParameter("FormRange", (firstFormNo + "-" + lastFormNo), true);

                    ReportDataSource dataSource = new ReportDataSource("ds_Form11", dsForm11.Tables[0].Copy());
                    ReportViewer viewer = new ReportViewer();
                    viewer.LocalReport.Refresh();
                    viewer.LocalReport.ReportPath = "Report/Form11.rdlc";
                    viewer.LocalReport.EnableExternalImages = true;
                    viewer.LocalReport.SetParameters(param);
                    viewer.LocalReport.DataSources.Add(dataSource);
                    viewer.LocalReport.SubreportProcessing += new SubreportProcessingEventHandler(SetEnrolmentFormsSubDataSource);
                    bytes = viewer.LocalReport.Render("PDF", null, out mimeType, out encoding, out extension, out streamIds, out warnings);
                }
            }

            return bytes;
        }
        #endregion

        #region SetEnrolmentFormsSubDataSource
        /// <summary>
        /// Sets the enrolment forms sub data source.
        /// </summary>
        /// <param name="sender">The sender.</param>
        /// <param name="e">The <see cref="SubreportProcessingEventArgs"/> instance containing the event data.</param>
        private void SetEnrolmentFormsSubDataSource(object sender, SubreportProcessingEventArgs e)
        {
            long FormId = Convert.ToInt32(e.Parameters[0].Values[0]);

            if (FormId > 0)
            {
                DataTable tblSubRCardFiltered = dsForm11.Tables[1].AsEnumerable().Where(row => row.Field<int>("FormId") == FormId).CopyToDataTable();
                tblSubRCardFiltered.TableName = "tblSubForm11";
                ReportDataSource datasource = new ReportDataSource("ds_SubForm11", tblSubRCardFiltered);
                e.DataSources.Add(datasource);
            }
        }
        #endregion
    }
}


public class TestABC
{
    public byte[] bytes { get; set; }
    public MemoryStream memoryStream { get; set; }
    public string fileName { get; set; }
}