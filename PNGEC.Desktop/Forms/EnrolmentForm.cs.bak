        #region dgEnrolmentForms_CellContentClick
        /// <summary>
        /// Handles the CellContentClick event of the dgEnrolmentForms control.
        /// </summary>
        /// <param name="sender">The source of the event.</param>
        /// <param name="e">The <see cref="DataGridViewCellEventArgs"/> instance containing the event data.</param>
        private async void dgEnrolmentForms_CellContentClick(object sender, DataGridViewCellEventArgs e)
        {
            if (e.RowIndex >= 0 && dgEnrolmentForms.Columns[e.ColumnIndex].Name == "Print")
            {
                try
                {
                    #region EnrolmentForms

                    var saveFileDialog = new SaveFileDialog();
                    saveFileDialog.FileName = GetFileNameStr(e, "form11");
                    saveFileDialog.DefaultExt = ".pdf";
                    if (saveFileDialog.ShowDialog() == DialogResult.OK)
                    {
                        GlobalsModel.mainMaster.ShowLoader();

                        if (Path.GetExtension(saveFileDialog.FileName) != ".pdf")
                        {
                            this.DeleteEnrolmentForm(Convert.ToInt32(dgEnrolmentForms.Rows[e.RowIndex].Cells["EnrolmentFormId"].Value));
                            MessageBox.Show("Only .pdf format is supported.", "PNGEC", MessageBoxButtons.OK, MessageBoxIcon.Warning);
                        }
                        else
                        {
                            byte[] bytes = await EnrolmentFormsExportReportSource(Convert.ToInt32(dgEnrolmentForms.Rows[e.RowIndex].Cells["StartRange"].Value),
                            Convert.ToInt32(dgEnrolmentForms.Rows[e.RowIndex].Cells["EndRange"].Value),
                            Convert.ToInt32(dgEnrolmentForms.Rows[e.RowIndex].Cells["RegionId"].Value),
                            Convert.ToInt32(dgEnrolmentForms.Rows[e.RowIndex].Cells["ProvinceId"].Value),
                            Convert.ToInt32(dgEnrolmentForms.Rows[e.RowIndex].Cells["DistrictId"].Value),
                            Convert.ToInt32(dgEnrolmentForms.Rows[e.RowIndex].Cells["LLGId"].Value),
                            Convert.ToInt32(dgEnrolmentForms.Rows[e.RowIndex].Cells["WardId"].Value),
                            Convert.ToString(dgEnrolmentForms.Rows[e.RowIndex].Cells["BatchName"].Value));

                            if (bytes != null)
                            {
                                using (FileStream stream = new FileStream(saveFileDialog.FileName, FileMode.Create))
                                {
                                    stream.Write(bytes, 0, bytes.Length);
                                }

                                this.DeleteQRCodeImagesDirectory();
                                MessageBox.Show("Form11 generated successfully ", "PNGEC", MessageBoxButtons.OK, MessageBoxIcon.Information);
                            }
                            else
                            {
                                this.DeleteQRCodeImagesDirectory();
                                this.DeleteEnrolmentForm(Convert.ToInt32(dgEnrolmentForms.Rows[e.RowIndex].Cells["EnrolmentFormId"].Value));
                                MessageBox.Show("Error in saving the PDF file(s).", "PNGEC", MessageBoxButtons.OK, MessageBoxIcon.Warning);
                            }
                        }
                    }
                    else
                    {
                        this.DeleteEnrolmentForm(Convert.ToInt32(dgEnrolmentForms.Rows[e.RowIndex].Cells["EnrolmentFormId"].Value));
                    }

                    #endregion
                }
                catch (Exception ex)
                {
                    ErrorLog.Write("EnrolmentForm", "dgEnrolmentForms_CellContentClick - Print", ex);
                    MessageBox.Show("Something went wrong", "PNGEC", MessageBoxButtons.OK, MessageBoxIcon.Error);
                }
                finally
                {
                    if(dtForm11 != null)
                    {
                        dtForm11.Clear();
                    }

                    if (dtSubForm11 != null)
                    {
                        dtSubForm11.Clear();
                    }

                    if (dsForm11 != null)
                    {
                        dsForm11.Clear();
                    }

                    GlobalsModel.mainMaster.HideLoader();
                }
            }
            else if (e.RowIndex >= 0 && dgEnrolmentForms.Columns[e.ColumnIndex].Name == "PrintRegistrationCard")
            {
                pdfDialog.FileName = GetFileNameStr(e, "registrsation_card");
                //pdfDialog.FileName = "enrolmentRegistrationCard_" + dgEnrolmentForms.Rows[e.RowIndex].Cells["ProvinceId"].Value + "_" + dgEnrolmentForms.Rows[e.RowIndex].Cells["StartRange"].Value + "_" + dgEnrolmentForms.Rows[e.RowIndex].Cells["EndRange"].Value;
                if (pdfDialog.ShowDialog() == DialogResult.OK)
                {
                    if (Path.GetExtension(pdfDialog.FileName) != ".pdf")
                    {
                        MessageBox.Show("Only .pdf format is supported.", "PNGEC", MessageBoxButtons.OK, MessageBoxIcon.Warning);
                    }
                    else
                    {
                        byte[] bytes = null;

                        dsRegistrationCard = new DataSet();
                        DataTable dtSubRCard = new DataTable();

                        string geoLocation = string.Format(@"{0}\{1}\{2}\{3}", dgEnrolmentForms.Rows[e.RowIndex].Cells["ProvinceName"].Value, dgEnrolmentForms.Rows[e.RowIndex].Cells["DistrictName"].Value, dgEnrolmentForms.Rows[e.RowIndex].Cells["LLGName"].Value, dgEnrolmentForms.Rows[e.RowIndex].Cells["WardName"].Value);

                        DataTable dtRCard = await GenerateRegistrationCardNo(Convert.ToInt32(dgEnrolmentForms.Rows[e.RowIndex].Cells["StartRange"].Value), Convert.ToInt32(dgEnrolmentForms.Rows[e.RowIndex].Cells["EndRange"].Value), Convert.ToInt32(dgEnrolmentForms.Rows[e.RowIndex].Cells["ProvinceId"].Value), Convert.ToInt32(dgEnrolmentForms.Rows[e.RowIndex].Cells["WardId"].Value));
                        #region dtSubRCard
                        dtSubRCard.Clear();
                        dtSubRCard.Columns.Add("RegistrationCardNo");
                        dtSubRCard.Columns.Add("Ward");
                        foreach (DataRow DataRow in dtRCard.Rows)
                        {
                            DataRow dtRow = dtSubRCard.NewRow();
                            dtRow["RegistrationCardNo"] = DataRow["RegistrationCardNo"];
                            dtRow["Ward"] = geoLocation;

                            dtSubRCard.Rows.Add(dtRow);
                        }
                        #endregion

                        dsRegistrationCard.Tables.AddRange(new DataTable[] { dtRCard, dtSubRCard });

                        bytes = this.ExportRegistrationCard();
                        using (FileStream stream = new FileStream(pdfDialog.FileName, FileMode.Create))
                        {
                            stream.Write(bytes, 0, bytes.Length);
                        }
                        dsRegistrationCard.Clear();
                        //RegistrationCardReport registrationCard = new RegistrationCardReport(dsRegistrationCard);
                        //registrationCard.Show();
                    }
                    StopLoader();
                }
            }
            else if (e.RowIndex >= 0 && dgEnrolmentForms.Columns[e.ColumnIndex].Name == "View")
            {
                var comment = dgEnrolmentForms.Rows[e.RowIndex].Cells["Comment"].Value;
                if (!string.IsNullOrEmpty(Convert.ToString(comment)) && !string.IsNullOrWhiteSpace(Convert.ToString(comment)))
                {
                    ViewComment commentModel = new ViewComment(Convert.ToString(comment));
                    if (commentModel.ShowDialog() == DialogResult.OK)
                    {
                        //await GridViewSetting();
                    }
                }
                else
                {
                    // No comments their.
                    MessageBox.Show("There is no comment to view.", "PNGEC", MessageBoxButtons.OK, MessageBoxIcon.Information);
                }
            }
            else if (e.RowIndex >= 0 && dgEnrolmentForms.Columns[e.ColumnIndex].Name == "Download")
            {
                var attachment = dgEnrolmentForms.Rows[e.RowIndex].Cells["EnrolmentFormId"].Value;
                var attachmnets = ListOfEnrols.Where(d => d.EnrolmentFormId == Convert.ToInt32(attachment)).SelectMany(f => f.AttachmentUrlList).ToList();
                //var fileName = GetFileNameStr(e, "attachment");
                DownloadAttachmnets(attachmnets);
            }
        }
        #endregion

        #endregion

        #region Methods

        #region Get File Name Str
        /// <summary>
        /// Gets the file name string.
        /// </summary>
        /// <param name="e">The <see cref="DataGridViewCellEventArgs"/> instance containing the event data.</param>
        /// <param name="appendStr">The append string.</param>
        /// <returns></returns>
        private string GetFileNameStr(DataGridViewCellEventArgs e, string appendStr)
        {
            var province = Convert.ToString(dgEnrolmentForms.Rows[e.RowIndex].Cells["ProvinceName"].Value);
            var district = Convert.ToString(dgEnrolmentForms.Rows[e.RowIndex].Cells["DistrictName"].Value);
            var llg = Convert.ToString(dgEnrolmentForms.Rows[e.RowIndex].Cells["LLGName"].Value);
            var ward = Convert.ToString(dgEnrolmentForms.Rows[e.RowIndex].Cells["WardName"].Value);
            var batchName = Convert.ToString(dgEnrolmentForms.Rows[e.RowIndex].Cells["BatchName"].Value);
            var str = string.Empty;

            if (!string.IsNullOrEmpty(district))
            {
                str = province + "_" + district;
            }
            if (!string.IsNullOrEmpty(llg))
            {
                str += "_" + llg;
            }
            if (!string.IsNullOrEmpty(ward))
            {
                str += "_" + ward;
            }
            if (!string.IsNullOrEmpty(batchName))
            {
                str += "_" + batchName;
            }
            return str + "_" + appendStr;
        }
        #endregion

        #region Download Attachmnets
        /// <summary>
        /// Downloads the attachmnets.
        /// </summary>
        /// <param name="attachment">The attachment.</param>
