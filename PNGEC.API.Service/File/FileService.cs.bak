                    lstresponse.Message = ResponseMessage.RecordNotExist;                    
                }
            }
            catch (Exception ex)
            {
                lstresponse.Message = ResponseMessage.SomethingWentWrong;
                lstresponse.Data = null;
                lstresponse.Status = false;
                lstresponse.Message = ex.Message;
